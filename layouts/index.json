{{- $items := slice -}}
{{- range where site.RegularPages "Section" "blog" -}}
    {{- $items = $items | append (dict
        "title" .Title
        "url" .RelPermalink
        "type" "blog"
        "meta" (.Params.summary | default (.Summary | plainify | truncate 60))
    ) -}}
{{- end -}}
{{- range where site.RegularPages "Section" "weread" -}}
    {{- $items = $items | append (dict
        "title" .Title
        "url" .RelPermalink
        "type" "weread"
        "meta" (.Params.author | default "")
    ) -}}
{{- end -}}
{{- range where site.Pages "Section" "topics" -}}
    {{- if not .Parent.IsHome -}}
        {{- $items = $items | append (dict
            "title" .Title
            "url" .RelPermalink
            "type" "topic"
            "meta" (.Params.description | default "")
        ) -}}
    {{- end -}}
{{- end -}}
{{ $items | jsonify }}

{{- range where site.RegularPages "Section" "weekly" -}}
    {{- $items = $items | append (dict
        "title" .Title
        "url" .RelPermalink
        "type" "weekly"
        "meta" (printf "第 %v 期" .Params.issue)
    ) -}}
{{- end -}}
